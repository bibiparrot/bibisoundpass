<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="SoundPass"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="bibiparrot"
           UpgradeCode="BC0B5B18-21AC-4A8D-B298-714BFA69D1D7">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of SoundPass is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SoundPass" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="SenderExecutable" Guid="*" Win64="yes">
        <File Id="SenderFile" Source="$(var.SourceDir)\soundpass-send.exe" KeyPath="yes" />
        <Environment Id="AddInstallFolderToPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>
      <Component Id="ReceiverExecutable" Guid="*" Win64="yes">
        <File Id="ReceiverFile" Source="$(var.SourceDir)\soundpass-recv.exe" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeFileComponent" Guid="*" Win64="yes">
        <File Id="ReadmeFile" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFileComponent" Guid="*" Win64="yes">
        <File Id="LicenseFile" Source="$(var.SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="SoundPass" Level="1">
      <ComponentRef Id="SenderExecutable" />
      <ComponentRef Id="ReceiverExecutable" />
      <ComponentRef Id="ReadmeFileComponent" />
      <ComponentRef Id="LicenseFileComponent" />
    </Feature>
  </Product>
</Wix>
